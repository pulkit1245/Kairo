PORT=4000
DATABASE_URL=postgresql://kairo:kairo@localhost:5432/kairo

# where repos get cloned. defaults to <os tmp>/kairo-workspace if left empty
WORKSPACE_DIR=
CLONE_TIMEOUT_MS=60000

# vite dev server
CORS_ORIGIN=http://localhost:5173

# cluster credentials: the kairo-platform service account, written by
# infra/scripts/kairo-kubeconfig.sh. Leave empty to use ~/.kube/config (admin)
KUBECONFIG=/Users/<you>/.kube/kairo-platform.yaml

# shared bearer token Alertmanager sends to /api/alerts (FR-45). Same value as
# alert_webhook_token in infra/terraform/terraform.tfvars. Generate with
# openssl rand -hex 32. Without it every alert gets 401
ALERT_WEBHOOK_TOKEN=

# keep this true until the cluster + RBAC are ready. when true the webhook
# records incidents but doesn't touch any pods
REMEDIATION_DRY_RUN=true

LOG_LEVEL=info

# where the browser reaches Kairo. GitHub sends people back to
# <APP_URL>/api/auth/callback (register exactly that as the App's callback URL)
APP_URL=http://localhost:5173

# the Kairo GitHub App (FR-1, FR-4), from its settings page on GitHub
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
# secret: generate it on the App's page and paste it here, never commit it
GITHUB_CLIENT_SECRET=
# the App's private key file, outside the repo, chmod 600 (PQ8)
GITHUB_APP_PRIVATE_KEY_PATH=~/.kairo/kairo-github-app.pem

# signs the session cookie. Generate with openssl rand -hex 32
SESSION_SECRET=
# GitHub logins that may sign in, comma separated (FR-2)
ALLOWED_GITHUB_LOGINS=

# Prometheus through a port-forward (FR-57), and Traefik on localhost for
# Send Traffic (FR-62). The backend opens the port-forward itself and keeps it
# open (restarts it after a Mac, Docker Desktop or Prometheus restart), as
# kairo-platform; set PROMETHEUS_PORT_FORWARD=false to run it by hand instead
# (npm run prom:forward). KUBECTL_PATH points at another kubectl
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT_FORWARD=true
KUBECTL_PATH=kubectl
TRAEFIK_URL=http://localhost

# P4: the public link (FR-40). One Cloudflare quick tunnel per running app,
# pointed at TRAEFIK_URL. Install with: brew install cloudflared
TUNNELS_ENABLED=true
CLOUDFLARED_PATH=cloudflared

# P4: Gemini fills facts the rules can't find and explains failed builds and
# incidents (FR-17 to FR-20, FR-28, FR-53). Get a key at aistudio.google.com.
# Secret: never commit it. GEMINI_ENABLED=false turns every call off
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# tried in order when the model before is busy, slow, failing or out of quota;
# comma separated, empty for none. One attempt per model, 4 in all at most.
# The Flash Lite models have much larger free quotas (500 a day vs 20)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# per attempt, so a slow model can't hold up the rest of the chain
GEMINI_TIMEOUT_MS=15000
