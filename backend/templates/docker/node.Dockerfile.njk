# Generated by Kairo for {{ appName }}. Node {{ node.version }}, {{ node.packageManager }}.
# -slim (Debian, glibc): native modules such as sqlite3 have prebuilt binaries
# for it, so npm needs no compiler. On Alpine (musl) they compile and fail.
FROM node:{{ node.version }}-slim

WORKDIR /app
{% if node.corepack %}

# {{ node.packageManager }} comes through corepack, at the version the repo asks for
RUN corepack enable
{% endif %}

COPY . .
RUN {{ node.installCommand }}
{% if node.buildCommand %}
RUN {{ node.buildCommand }}
{% if node.pruneCommand %}
RUN {{ node.pruneCommand }}
{% endif %}
{% endif %}

ENV NODE_ENV=production
ENV PORT={{ port }}
EXPOSE {{ port }}

CMD {{ startCommand | dump }}
