FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
# npm ci needs a lockfile, plenty of student repos don't commit one
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

COPY . .

ENV NODE_ENV=production
ENV PORT={{ port }}
EXPOSE {{ port }}

CMD {{ startCommand | dump }}
