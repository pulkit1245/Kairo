# Generated by Kairo for {{ appName }}. Python {{ python.version }}{% if python.frameworkLabel %}, {{ python.frameworkLabel }}{% endif %}.
FROM python:{{ python.version }}-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
{% if python.install == "requirements" %}
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
{% elif python.install == "packages" and python.packages.length %}
RUN {{ ["pip", "install", "--no-cache-dir"].concat(python.packages) | dump }}
{% endif %}{% if python.serverPackage %}
# the server isn't in the repo's dependencies
RUN pip install --no-cache-dir {{ python.serverPackage }}
{% endif %}
COPY . .
{% if python.install == "requirements-after-copy" %}
RUN pip install --no-cache-dir -r requirements.txt
{% elif python.install == "project" %}
RUN pip install --no-cache-dir .
{% endif %}{% if python.collectstatic %}
RUN python manage.py collectstatic --noinput
{% endif %}
ENV PORT={{ port }}
EXPOSE {{ port }}

CMD {{ startCommand | dump }}
