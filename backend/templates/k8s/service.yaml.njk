apiVersion: v1
kind: Service
metadata:
  name: {{ appName }}
  namespace: {{ namespace }}
  labels:
    app: {{ appName }}
    app.kubernetes.io/managed-by: kairo
spec:
  # cluster-internal only: all outside traffic comes in through Traefik's
  # Ingress, so request metrics are always counted (FR-39)
  type: ClusterIP
  selector:
    app: {{ appName }}
  ports:
    - name: http
      port: 80
      targetPort: {{ port }}
