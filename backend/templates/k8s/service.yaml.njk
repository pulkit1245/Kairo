apiVersion: v1
kind: Service
metadata:
  name: {{ appName }}
  namespace: {{ namespace }}
  labels:
    app: {{ appName }}
    app.kubernetes.io/managed-by: kairo
spec:
  # NodePort for now; Kairo's Traefik Ingress takes over traffic later
  type: NodePort
  selector:
    app: {{ appName }}
  ports:
    - port: 80
      targetPort: {{ port }}
