# Generated by Kairo (FR-24). On every push to {{ defaultBranch }}: {% if test %}run the tests, {% endif %}build the
# image for amd64 and arm64, push it to GHCR with this workflow's own token, and
# scan it with Trivy (report only, it never fails the build). Kairo watches
# GHCR and rolls the new image out.
#
# Every action is pinned to a full commit SHA, not a tag: tags can be moved
# (as happened to trivy-action in March 2026). Trivy runs from its image,
# pinned by digest.
name: kairo

on:
  push:
    branches: [{{ defaultBranch }}]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

env:
  IMAGE: {{ image }}

jobs:
{% if test %}
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: {{ test.nodeVersion }}
{% if test.corepack %}
      - run: corepack enable
{% endif %}
      - run: {{ test.installCommand }}
      - run: {{ test.testCommand }}

{% endif %}
  image:
{% if test %}
    needs: test
{% endif %}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
      - uses: docker/setup-qemu-action@c7c53464625b32c7a7e944ae62b3e17d2b600130 # v3.7.0
      - uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3.12.0
      - uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3.7.0
        with:
          registry: ghcr.io
          username: {{ gh('github.actor') }}
          password: {{ gh('secrets.GITHUB_TOKEN') }}

      # both architectures: the Kairo laptop is arm64, most servers are amd64
      - uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6.19.2
        with:
          context: .
{% if dockerfile %}
          file: {{ dockerfile }}
{% endif %}
          platforms: linux/amd64,linux/arm64
          push: true
          tags: {{ gh('env.IMAGE') }}:{{ gh('github.sha') }}
          # links the package to this repo, so it inherits its visibility
          labels: org.opencontainers.image.source=https://github.com/{{ repoFullName }}

      # Trivy 0.76.1, by image digest
      - name: Trivy scan (report only)
        env:
          TRIVY_USERNAME: {{ gh('github.actor') }}
          TRIVY_PASSWORD: {{ gh('secrets.GITHUB_TOKEN') }}
        run: >-
          docker run --rm -e TRIVY_USERNAME -e TRIVY_PASSWORD
          aquasec/trivy@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
          image --exit-code 0 --severity HIGH,CRITICAL --ignore-unfixed --no-progress
          {{ gh('env.IMAGE') }}:{{ gh('github.sha') }}
